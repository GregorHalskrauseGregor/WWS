TELEGRAM_BOT_TOKEN=hier_deinen_telegram_bot_token_einfuegen

# Welcher KI-Anbieter verwendet werden soll: anthropic | openai | minimax
AI_PROVIDER=minimax

# Nur den Block ausfüllen, der zum gewählten AI_PROVIDER passt

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- AssemblyAI (für Sprachnachrichten, Batch/Pre-recorded, EU-Endpunkt) ---
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com

# --- Mistral OCR (für Fotos, Screenshots, PDFs von Lieferscheinen/Materiallisten) ---
MISTRAL_API_KEY=

# --- MiniMax ---
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2
