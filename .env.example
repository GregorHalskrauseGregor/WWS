TELEGRAM_BOT_TOKEN=8844280283:AAHCsxJGnyp_4Ns1lsnv3ZSK3wyMqGJ_2kQ

# Welcher KI-Anbieter soll die HAUPT-Antworten generieren? anthropic | openai | minimax
# Alle drei unterstützen Tool-Use (Anthropic/OpenAI nativ, MiniMax per XML-Parser).
AI_PROVIDER=minimax

# Optional: zweiter, kleinerer Anbieter/Modell für Themen-Klassifikation
# und Gedächtnis-Komprimierung. Spart bei vielen Usern deutlich Kosten.
# Bleibt leer, dann übernimmt AI_PROVIDER auch diese Aufgaben.
# AI_PROVIDER_LIGHT=openai
# OPENAI_MODEL_LIGHT=gpt-4o-mini

# --- Anthropic (Hauptmodell) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional, nur wenn AI_PROVIDER_LIGHT=anthropic gesetzt ist:
# ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5

# --- OpenAI (Hauptmodell) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional, nur wenn AI_PROVIDER_LIGHT=openai gesetzt ist:
# OPENAI_MODEL_LIGHT=gpt-4o-mini

# --- AssemblyAI (für Sprachnachrichten, Batch/Pre-recorded, EU-Endpunkt) ---
ASSEMBLYAI_API_KEY=fc1b01bdcc154bca9778b66785a774e9
ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com

# --- Mistral OCR (für Fotos, Screenshots, PDFs) ---
MISTRAL_API_KEY=

# --- Brave Search API (Web-Suche, EU-konform) ---
# Key gratis auf https://brave.com/search/api/ — ca. 2000 Suchanfragen/Monat frei.
# Ohne diesen Key steht der KI web_search nicht zur Verfügung; der Bot funktioniert
# trotzdem, nur eben ohne Such-Funktion.
BRAVE_API_KEY=BSAfBEY6F_WsQjy-5cM44LjCNn53bmB

# --- Jina Reader (URL → Markdown) ---
# Funktioniert auch ohne Key (mit Rate-Limit). Key gratis auf https://jina.ai/reader-api/
# für deutlich höheres Limit.
JINA_API_KEY=

# --- MiniMax (Hauptmodell) ---
MINIMAX_API_KEY=sk-cp-6rSUGpMXy5zplukSnD4DgTXQANiYJiO7Mg-rQr90hnRjZJP2bFFHE0NGLIdAiw0mQnNlZYGDkhHZu62PnIlPjg5N7PpPFS4uJfsmfyBfFIMLv6BQQZ1qhgw
MINIMAX_MODEL=MiniMax-M2
# Optional. ACHTUNG: nur ein Modell eintragen, das es wirklich gibt — MiniMax
# antwortet auf einen unbekannten Namen mit HTTP 200 und einem Fehler im Rumpf.
# Ohne diesen Eintrag nutzen auch die leichten Rollen MINIMAX_MODEL.
# MINIMAX_MODEL_LIGHT=

# ─────────────────────────────────────────────────────────────────────────
# KI-Anbieter je AUFGABE (alles optional)
# ─────────────────────────────────────────────────────────────────────────
# Ohne diese Zeilen gilt AI_PROVIDER für alles (bzw. AI_PROVIDER_LIGHT für
# die Hintergrundaufgaben router und summary). Pro Aufgabe überschreibbar:
#
#   chat        Antworten an den Nutzer
#   extraktion  Freitext -> strukturierte Daten (Aufmaß, Bestellung, Lager)
#   router      Faden- und Experten-Entscheidung  (billig + schnell reicht)
#   summary     Zusammenfassen, Gedächtnis pflegen (billig + schnell reicht)
#
# AI_PROVIDER_ROUTER=openai
# OPENAI_MODEL_ROUTER=gpt-4o-mini
# AI_PROVIDER_EXTRAKTION=anthropic
# ANTHROPIC_MODEL_EXTRAKTION=claude-sonnet-4-6

# Fallback-Kette: fällt der primäre Anbieter aus (Rate-Limit, 5xx, Timeout),
# übernimmt der nächste. Reine Programmfehler lösen KEINEN Wechsel aus.
# AI_FALLBACK_KETTE=openai,minimax

# ─────────────────────────────────────────────────────────────────────────
# Fach-Dienste — Reihenfolge = Fallback-Kette
# ─────────────────────────────────────────────────────────────────────────
# Ein neuer Anbieter ist eine neue Datei unter dienste/<art>/ mit
# { name, verfuegbar(), benoetigt, ausfuehren() }. Danach hier eintragen.
# OCR_KETTE=mistral
# TRANSKRIPTION_KETTE=assemblyai
# SUCHE_KETTE=brave
# LESEN_KETTE=jina

# ─────────────────────────────────────────────────────────────────────────
# Datenverzeichnis
# ─────────────────────────────────────────────────────────────────────────
# Standard: ./data. Auf Railway auf den Volume-Mountpfad setzen.
# WWS_DATA=/app/data

# ── Lager-Bot (zweiter Telegram-Bot, nur fuer den Lageristen) ──────────────
# Ohne diesen Token laeuft alles wie bisher, nur bekommt niemand die
# Reservierungen zur Bestaetigung. Token beim BotFather anlegen.
TELEGRAM_LAGER_TOKEN=

# ── Admin-Zugang zu /options ──────────────────────────────────────────────
# Ohne gesetztes Kennwort gibt es KEINEN Admin-Bereich — dann kann niemand
# Rollen vergeben. Das ist Absicht: ein leeres Kennwort waere ein offenes.
ADMIN_KENNWORT=

# ── Grosshandel-Service (Playwright auf Hetzner) ──────────────────────────
# Die URL zeigt auf deine Hetzner-Box, der Token identisch mit SERVICE_TOKEN
# in grosshandel-service/.env. Ohne diese Vars ist der Grosshandel-Experte
# deaktiviert und meldet das auch.
GROSSHANDEL_SERVICE_URL=http://2.29.36.221:8787
GROSSHANDEL_SERVICE_TOKEN=

# ── Zugangs-Code (Login-Gate fuer Telegram-Nutzer) ────────────────────────
# Jeder neue Chat muss diesen Code einmal schicken. Danach steht er auf der
# Freigabeliste (data/zugang.json) und wird nie wieder gefragt. Solange der
# Code nicht stimmt, kommt keine Nachricht am Router an — der Bot antwortet
# ausschliesslich mit der Aufforderung, den Code zu schicken.
#
# WICHTIG: Ist diese Zeile LEER oder fehlt sie, ist der Bot OFFEN wie bisher
# (mit lauter Warnung beim Start). Das ist Absicht: ein Tippfehler hier soll
# nicht dazu fuehren, dass sich niemand mehr anmelden kann.
# Freischalten von Hand: /zugang zeigt die Liste, /zugang <chatId> entzieht.
ZUGANGS_CODE=

# ── Forum-Gruppe fuer ausgelagerte Faeden (optional) ──────────────────────
# Telegram erlaubt Bots NICHT, selbst Gruppen zu erstellen. Was ein Bot darf:
# in einer Supergruppe mit eingeschalteten "Themen" (Topics), in der er Admin
# ist, eigene Themen anlegen. Genau das nutzt /gruppe.
#
# Einmalige Einrichtung:
#   1. Gruppe in Telegram anlegen
#   2. In den Gruppen-Einstellungen "Themen" einschalten (macht sie zur
#      Forum-Supergruppe)
#   3. Diesen Bot als Administrator hinzufuegen, Recht "Themen verwalten"
#      (und "Nutzer einladen", damit auch ein Einladungslink entsteht)
#   4. Chat-ID der Gruppe hier eintragen (beginnt mit -100...)
#
# Ohne diesen Eintrag funktioniert der manuelle Weg weiter: Gruppe selbst
# anlegen, Bot hinzufuegen, dort /faden_hierher schreiben.
TELEGRAM_FORUM_CHAT_ID=

# ── Werkzeug-Registry (optional) ──────────────────────────────────────────
# Standard: ./werkzeuge.md im Projektwurzelverzeichnis. Nur setzen, wenn die
# Registry woanders liegen soll. Fehlt die Datei, laufen alle Experten wie
# bisher — die Registry ist rein additiv.
# WWS_WERKZEUGE=/app/werkzeuge.md

# ═════════════════════════════════════════════════════════════════════════
# AUFTRAGSSTELLE — nur auf der Hetzner-Box setzen
# ═════════════════════════════════════════════════════════════════════════
#
# Der Bot läuft auf der Box, die Browser-Navigation im Großhändler-Portal auf
# dem Laptop (GC sperrt Rechenzentrums-IPs). Die Box kann den Laptop nicht
# anrufen, also fragt der Laptop nach. Diese drei Zeilen öffnen die Tür dafür.
#
# Sobald AGENT_TOKEN gesetzt ist, arbeitet der Großhandel-Experte im
# Warteschlangen-Betrieb: Bestellung einstellen, Laptop holt sie ab, Ergebnis
# kommt später per Telegram. Ist AGENT_TOKEN LEER, läuft alles wie bisher
# direkt gegen GROSSHANDEL_SERVICE_URL.
#
# Der Token muss auf beiden Seiten identisch sein — hier und in der .env des
# Laptop-Agenten. Erzeugen:  openssl rand -hex 32
AGENT_TOKEN=

# Port, auf dem der Laptop-Agent anklopft. ⚠️ Auf der Box läuft noch der
# Kalenderbot — vor dem Start prüfen, ob der Port frei ist:
#     ss -tlnp | grep 8788
# Belegt? Hier eine andere Zahl eintragen; docker-compose.yml zieht daraus.
AGENT_PORT=8788

# An welche Adresse gebunden wird. Im Container muss das 0.0.0.0 bleiben,
# sonst kommt niemand von außen durch.
AGENT_HOST=0.0.0.0

# Wie lange ein Auftrag beim Laptop liegen darf, bevor die Box ihn für
# verschollen hält. Standard 8 Minuten. Nur anfassen, wenn Bestellungen
# regelmäßig länger brauchen.
# AUFTRAG_LEASE_MS=480000

# ── Direktbetrieb (nur wenn der Bot auf demselben Rechner wie der Browser läuft)
# Auf der Box bleiben diese beiden LEER — dort ist der Laptop zuständig.
# GROSSHANDEL_SERVICE_URL=http://127.0.0.1:8787
# GROSSHANDEL_SERVICE_TOKEN=
