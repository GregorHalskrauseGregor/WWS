# Bearer-Token, mit dem der WWS-Bot den Service ruft.
# MUSS identisch sein mit GROSSHANDEL_SERVICE_TOKEN in der WWS-.env
# Mindestens 32 Zeichen, am besten `openssl rand -hex 32`
SERVICE_TOKEN=

# Welche Grosshaendler sollen verfuegbar sein? Pro Grosshaendler
# die Zugangsdaten eintragen (nur die, die du auch nutzt).
GC_USER=
GC_PASS=
RNF_USER=
RNF_PASS=

# Browser headless? In Produktion: true. Zum Debuggen: false (noetigt X-Server,
# in Docker nur ueber VNC sichtbar)
HEADLESS=true

# Port, auf dem der Service hoert
PORT=8787

# Log-Level: trace, debug, info, warn, error
LOG_LEVEL=info
