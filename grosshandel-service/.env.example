# Bearer-Token, mit dem der WWS-Bot den Service ruft.
# MUSS identisch sein mit GROSSHANDEL_SERVICE_TOKEN in der WWS-.env
# Mindestens 32 Zeichen, am besten `openssl rand -hex 32`
SERVICE_TOKEN=

# Welche Grosshaendler sollen verfuegbar sein? Pro Grosshaendler
# die Zugangsdaten eintragen (nur die, die du auch nutzt).
GC_USER=
GC_PASS=
RNF_USER=
RNF_PASS=

# Standard-Empfaenger fuer "Weiterleiten" (an wen der Warenkorb im
# Grosshaendler-Portal geschickt wird). Pro Job kann das im Payload ueber-
# schrieben werden (job.empfaenger). Default: ENV-Wert.
GC_FORWARD_TO=MARIOHENRICH

# Optional: Proxy fuer Playwright (z. B. Webshare Residential, SSH-Tunnel)
# Format PROXY_URL: scheme://host:port
# Beispiele:
#   PROXY_URL=http://31.58.9.4:6077      (Webshare, HTTP-Proxy)
#   PROXY_URL=socks5://127.0.0.1:11080  (SSH-Tunnel)
# Falls Auth noetig: PROXY_USER + PROXY_PASS separat setzen
#   PROXY_URL=http://31.58.9.4:6077
#   PROXY_USER=snlxiipu
#   PROXY_PASS=0vd4tlgwrisg
# Leer lassen = direkte Verbindung (wird von GC ggf. geblockt)
# PROXY_URL=
# PROXY_USER=
# PROXY_PASS=

# --- Browser (Variante B: echtes Chrome, empfohlen) ---
# BROWSER_CHANNEL=chrome  -> echtes Google-Chrome-Binary (echter Fingerprint, kommt an GCs
#                            Bot-Schutz vorbei). 'chromium' = Playwright-Build, wird geblockt.
BROWSER_CHANNEL=chrome
# HEADLESS=false -> sichtbares Chrome-Fenster. Am wenigsten erkennbar, deshalb Default false.
#                  Nur auf einem echten Desktop mit Bildschirm sinnvoll (auf Server: xvfb noetig).
HEADLESS=false
# Optional (Variante A): an ein bereits laufendes Chrome andocken statt selbst starten.
# NUR setzen, wenn Chrome mit --remote-debugging-port=9222 UND eigenem --user-data-dir laeuft.
# Fuer Variante B LEER lassen, sonst wird Variante A genutzt!
# CDP_ENDPOINT=http://localhost:9222

# --- Login-Modus ---
# auto (Standard): Bot loggt sich selbst ein — mit ECHTEN Tastatureingaben
#   (Zeichen fuer Zeichen). Das ist noetig, weil GCs Framework per .fill()
#   gesetzte Werte ignoriert (fuehrte zu Fehler 11221777).
# session: Bot tippt NICHT, sondern nutzt eine von Hand im Bot-Profil
#   angemeldete Session — nur sinnvoll, wenn GC die Session speichert
#   (tut es aktuell nicht).
GC_LOGIN_MODE=auto

# Port, auf dem der Service hoert
PORT=8787

# Log-Level: trace, debug, info, warn, error
LOG_LEVEL=info

# --- KI-Fallback (Self-Healing), austauschbarer Anbieter ---
# Nur aktiv, wenn AI_API_KEY + AI_MODEL (+ bei provider=openai die AI_BASE_URL)
# gesetzt sind. Sonst laeuft der Bot rein deterministisch (Selektor-Strategien
# aus gc.yaml).
#
# AI_PROVIDER: "openai" = OpenAI-kompatibles Schema (MiniMax, Mistral, OpenAI, ...)
#              "anthropic" = Anthropic-Schema.
AI_PROVIDER=openai
# AI_BASE_URL: volle Chat-Completions-URL des Anbieters (nur bei provider=openai).
#   Nimm dieselbe URL + denselben Key wie in deinem KI-Excel-Tool.
#   Mistral (spaeter):  https://api.mistral.ai/v1/chat/completions
#   MiniMax (aktuell):  <die OpenAI-kompatible Chat-URL deines MiniMax-Zugangs>
AI_BASE_URL=
AI_API_KEY=
# AI_MODEL: Modell fuer die DOM-Stufe (Text). Exakte Modell-ID des Anbieters.
AI_MODEL=
# AI_VISION_MODEL: bildfaehiges Modell fuer die Vision-Stufe (Screenshot ->
#   Klick-Koordinaten). Leer = gleich wie AI_MODEL. Nur wenige Modelle treffen
#   Pixel-Koordinaten zuverlaessig — wenn unsicher: AI_VISION=false.
AI_VISION_MODEL=
# AI_VISION=false schaltet die Vision-Stufe ab (nur Deterministik + KI-DOM).
AI_VISION=true
# AI_MAX_STEPS: max. KI-Schritte pro Bestellung (Kostenbremse).
AI_MAX_STEPS=8

# ═════════════════════════════════════════════════════════════════════════
# LAPTOP-AGENT — holt Auftraege von der Hetzner-Box ab
# ═════════════════════════════════════════════════════════════════════════
#
# Seit der Bot auf der Box laeuft, ruft nicht mehr der Bot hier an, sondern
# dieser Rechner fragt dort nach Arbeit. Grund: dieser Laptop hat keine feste
# Adresse, sitzt hinter dem Router und schlaeft zwischendurch.
#
# Start:  node --env-file=.env agent.js
#   (oder bequemer: laptop-start.bat — startet Dienst und Agent zusammen)

# Adresse der Box. Mit Domain und HTTPS: https://bot.deine-domain.de
AUFTRAGSSTELLE_URL=http://<box-ip>:8788

# MUSS identisch sein mit AGENT_TOKEN in der WWS-.env auf der Box.
AGENT_TOKEN=

# Frei waehlbarer Name, erscheint in den Logs auf beiden Seiten.
AGENT_ID=felix

# Der lokale Playwright-Dienst (server.js auf diesem Rechner).
LOKALER_DIENST=http://127.0.0.1:8787

# ⚠️ WICHTIG AUF WINDOWS: ohne diese Zeile legt server.js seine Bilder unter
# C:\app\screenshots an — der Vorgabewert stammt aus dem Docker-Image.
SCREENSHOT_DIR=./screenshots
DATA_DIR=./data
LOG_DIR=./logs
